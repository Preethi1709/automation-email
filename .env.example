# NUNES PRODUCT INTELLIGENCE - V21.5 SURREAL HYPERSPEED
# Copy to .env only for a fresh install. Upgrade installer preserves your existing .env.

GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://127.0.0.1:5067/auth/google/callback"
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="PRODUCT_DATA"

APP_PORT="5067"
NUNES_DB_FILE="nunes_v213_fresh.db"

# V21.5 Stage 0/1 + independent Stage-2 specialist architecture
V214_MAIN_WORKERS="6"
V214_RESCUE_WORKERS="2"
V214_RESCUE_BATCH="2"
V214_MAX_RESCUE_ATTEMPTS="2"
V214_MAX_AI_ATTEMPTS="3"
V214_OCR_ENABLED="true"
V214_OCR_WORKERS="1"
V214_OCR_MAX_PAGES="8"
V214_OCR_RENDER_SCALE="1.55"

# V21.5 independent Stage-2 specialist lanes
V215_TEXT_WORKERS="6"
V215_PDF_WORKERS="2"
V215_TABLE_WORKERS="2"
V215_DOC_WORKERS="2"
V215_STAGE2_BATCH_MULTIPLIER="2"
V215_TASK_STALE_SECONDS="1200"
V215_OCR_PROBE_PAGES="2"
V215_OCR_MAX_PAGES="8"

# Local AI is exception-only. Python remains final authority.
LOCAL_AI_ENABLED="true"
OLLAMA_URL="http://127.0.0.1:11434"
LOCAL_AI_FAST_MODEL="qwen3:1.7b"
LOCAL_AI_DEEP_MODEL="qwen3:4b"
LOCAL_AI_VISION_MODEL="qwen3-vl:4b"
LOCAL_AI_TIMEOUT_SECONDS="120"
LOCAL_AI_FAST_KEEP_ALIVE="5m"
LOCAL_AI_HEAVY_KEEP_ALIVE="0"

# Supervisors
LIVE_SCAN_SECONDS="2"
DIRECT_ANALYSIS_SECONDS="1"
DIRECT_BATCH_SIZE="60"
DIRECT_SLICE_SIZE="8"
DIRECT_DRAIN_BUDGET_SECONDS="30"
HISTORY_SCAN_SECONDS="8"
HISTORY_PAGE_SIZE="500"
HISTORY_PAGES_PER_CYCLE="2"
COVERAGE_VERIFY_SECONDS="900"
UI_PUSH_SECONDS="2"
SHEET_EXPORT_SECONDS="5"
SHEET_EXPORT_BATCH_SIZE="250"
SHEETS_API_MAX_ATTEMPTS="4"
SHEETS_API_RETRY_BASE_SECONDS="1.0"
SHEETS_API_RETRY_MAX_SECONDS="12.0"
JOB_LEASE_SECONDS="300"
STALE_EMAIL_SECONDS="600"
MAX_JOB_ATTEMPTS="3"
BACKUP_SECONDS="21600"
BACKUP_KEEP="14"

# Resource protection
HYPERSPEED_FULL_SPEED="true"
HYPERSPEED_MIN_FREE_MEMORY_MB="1536"
HYPERSPEED_MIN_FREE_MEMORY_PERCENT="12"
